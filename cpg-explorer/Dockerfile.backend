# Build stage
FROM golang:1.26-alpine AS builder

# Install build dependencies for CGO
RUN apk add --no-cache gcc musl-dev sqlite-dev

WORKDIR /app

# Copy backend code
COPY backend/ .

# Download dependencies
RUN go mod download

# Build the binary
RUN CGO_ENABLED=1 go build -o cpg-explorer-api .

# Runtime stage
FROM alpine:latest

RUN apk add --no-cache sqlite-libs

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/cpg-explorer-api .

# Expose port
EXPOSE 8080

# Run the API
CMD ["./cpg-explorer-api", "-db", "/data/cpg.db", "-port", "8080"]
